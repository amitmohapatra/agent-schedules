# agent-schedules configuration.
#
# One prefix, SCHEDULES__, with __ between levels. Every value here has a default that works
# on a laptop; the ones that would be wrong in production are called out.
#
# Copy to .env and edit. Never commit .env: it is git-ignored for a reason.

# --- service -----------------------------------------------------------------------------
SCHEDULES__SERVICE__NAME=agent-schedules
SCHEDULES__SERVICE__ENVIRONMENT=dev
SCHEDULES__SERVICE__HOST=0.0.0.0
SCHEDULES__SERVICE__PORT=8092
# A key is the caller: it names the one tenant it speaks for and who it is (recorded as
# created_by on everything it creates). may_act_as lists the principals it may schedule runs
# *as* — "*" is the service grant a ticker needs to fire every schedule in its tenant.
# The tenant here must also exist in agent-runs' credentials: each service
# authenticates its own callers, so a run fired for a tenant agent-runs does not know
# is a 403 at fire time.
SCHEDULES__SERVICE__API_KEYS={"dev-key": {"tenant_id": "dev", "principal": "dev-user", "may_act_as": ["*"]}}
# Consecutive failed fires before a schedule pauses itself. Three is "not a blip".
SCHEDULES__SERVICE__MAX_CONSECUTIVE_FAILURES=3
# How long a schedule waits after a retryable fire failure before it is due again, doubling
# per consecutive failure. Without it the retry cadence is the ticker's, not the schedule's.
SCHEDULES__SERVICE__RETRY_BACKOFF_SECONDS=300.0

# --- database ----------------------------------------------------------------------------
SCHEDULES__DATABASE__URL=postgresql+psycopg://memory:memory@localhost:5432/agent_schedules
SCHEDULES__DATABASE__POOL_SIZE=10
SCHEDULES__DATABASE__ECHO=false

# --- agent-runs --------------------------------------------------------------------------
# Where a fired schedule turns into a run. Inside compose this is the service name, not
# localhost: localhost in a container is the container.
SCHEDULES__RUNS__URL=http://localhost:8090
SCHEDULES__RUNS__API_KEY=dev-key
# Short on purpose: a fire holds a row lock while this call is outstanding, so a slow
# agent-runs must become a recorded failure quickly rather than a stuck ticker.
SCHEDULES__RUNS__TIMEOUT_SECONDS=10.0

# --- observability -----------------------------------------------------------------------
SCHEDULES__OBSERVABILITY__LOG_LEVEL=INFO
SCHEDULES__OBSERVABILITY__LOG_JSON=true
SCHEDULES__OBSERVABILITY__OTEL_ENABLED=false
# SCHEDULES__OBSERVABILITY__OTEL_ENDPOINT=http://localhost:4317
